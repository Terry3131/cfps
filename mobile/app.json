{
  "expo": {
    "name": "CFPS Mobile",
    "slug": "cfps-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "usesCleartextTraffic": false
    },
    "extra": {
      "defaultApiBaseUrl": "https://cfps-backend.onrender.com",
      "notificationPollMs": 75000
    }
  }
}
