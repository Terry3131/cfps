NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Supabase pooled or direct PostgreSQL connection string.
# Prefer the Supabase pooled connection for Render free tier.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Generate a unique 32+ character value for temporary UAT.
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h

# Set to the deployed Vercel frontend origin. Comma-separate preview origins if needed.
CORS_ORIGIN=https://cfps-theta.vercel.app
ALLOW_DEV_CORS_ORIGINS=false
ENFORCE_HTTPS=true
TRUST_PROXY=true

# Render filesystem is ephemeral on free tier. Suitable only for temporary UAT.
UPLOAD_DIR=/tmp/cfps-uploads
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
NOTIFICATION_CHECK_INTERVAL_MINUTES=60
