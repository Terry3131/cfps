{
  "name": "cfps-desktop",
  "version": "1.0.0",
  "description": "CFPS Desktop Clerk Client",
  "author": "341 CIS Group",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "electron:dev": "electron .",
    "build": "vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "preview": "vite preview --host 0.0.0.0"
  },
  "build": {
    "appId": "com.cfps.desktop",
    "productName": "CFPS Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sqlite-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "axios": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sqlite-electron": "^3.8.5",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "electron": "latest",
    "electron-builder": "latest",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4"
  }
}
